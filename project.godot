; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Farm Arena"
run/main_scene="uid://cnqlbuwi5pw7r"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.png"
boot_splash/image="res://Resources/branding/splash.png"
boot_splash/bg_color=Color(0.31, 0.5, 0.18, 1)
boot_splash/fullsize=true
boot_splash/stretch_mode=4
boot_splash/use_filter=false
boot_splash/show_image=true
config/quit_on_go_back=false

[autoload]

GameManager="*res://Scripts/GameManager.gd"
DeckManager="*res://Scenes/deckmanager.tscn"
PlayerProfile="*res://Scenes/player_profile.tscn"
MatchSetup="*res://MatchMaker/match_setup.gd"
PlayerBehaviorProfiler="*res://AI/player_behavior_profiler.gd"
BotLearning="*res://AI/bot_learning.gd"
MusicPlayer="*res://Sounds/MusicPlayer.tscn"
Leaderboard="*res://ranking/Leaderboard.gd"
SeasonStats="*res://ranking/SeasonStats.gd"
BotSimulator="*res://AI/bot_simulator.tscn"
SeasonManager="*res://Scenes/season_manager.tscn"
Journal="*res://Scenes/journal.tscn"
PollManager="*res://journal/poll_manager.gd"
ArenaManager="*res://arenas/arena_manager.gd"
ThemeBuilder="*res://Resources/themes/theme_builder.gd"
MissionDatabase="*uid://diij0fj4n2s43"
NationDatabase="*uid://66ydh2255m1c"
UpdateDatabase="*uid://cje8dje601g28"
CardDatabase="*uid://bd8hogbekh1f4"
CustomContent="*res://creator/custom_content.gd"
Progresso="*res://Scripts/progresso.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"
window/handheld/orientation=1

[global_group]

damageable=""
navigation_polygon_source_geometry_group=""

[input_devices]

pointing/android/enable_pan_and_scale_gestures=true

[rendering]

textures/canvas_textures/default_texture_filter=0

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
